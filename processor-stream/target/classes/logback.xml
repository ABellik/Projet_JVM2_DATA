<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Console appender : affiche les logs sur la console -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level [%thread] %logger - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Silence Kafka et Kafka Streams : seulement ERROR -->
    <logger name="org.apache.kafka" level="ERROR"/>
    <logger name="org.apache.kafka.streams" level="ERROR"/>
    <logger name="io.confluent" level="ERROR"/> <!-- utile si tu utilises Schema Registry -->

    <!-- Racine : affiche INFO pour ton application -->
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <logger name="org.apache.kafka.streams.processor.internals.StateDirectory" level="WARN"/>


</configuration>
