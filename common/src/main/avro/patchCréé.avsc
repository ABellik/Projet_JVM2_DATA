{
    "type":"record",
    "name":"CreationPatch",
    "namespace": "com.example.events",
    "doc" : "Évènement émis lorsqu'un patch est créé par l'éditeur",
    "fields":
    [
        {
            "name": "id", 
            "type": "long"
        },

        {
            "name": "idJeu", 
            "type": "long"
        },

        {
            "name": "version", 
            "type": "string"
        },
        {
            "name": "nouvelleVersion",
            "type": "string",
            "default": "",
            "doc": "Ce champs est utilisé si le patch sert à publier une nouvelle version de jeu"
        },
        
        {
            "name": "commentaireEditeur", 
            "type": "string"
        },

        {
            "name": "modification", 
            "type": {"type": "enum","name": "typeModification","symbols": ["AJOUT", "CORRECTION","OPTIMISATION"]}
        }
    ]
}