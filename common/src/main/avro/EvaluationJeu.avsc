{
  "type": "record",
  "name": "EvaluationJeu",
  "namespace": "com.example.events",
  "fields": [
    { "name": "idJeu", "type": "long" },
    { "name": "Note", "type": "int" },
    { "name": "idJoueur", "type": "long" },
    {
      "name": "Commentaire",
      "type": ["null", "string"],
      "default": null
    },
    { "name": "DateEvaluationJeu", 
      "type": { "type": "long", "logicalType": "timestamp-millis" } 
    }
  ]
}
