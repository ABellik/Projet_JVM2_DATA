{
  "type": "record",
  "namespace": "com.example.events",
  "name": "OrderPlaced",
  "doc": "Évènement émis lorsqu'une commande est validée",
  "fields": [
    {
      "name": "orderId",
      "type": "string",
      "doc": "L'identifiant unique de la commande"
    },
    {
      "name": "userId",
      "type": "string",
      "doc": "L'identifiant du client"
    },
    {
      "name": "amount",
      "type": "double",
      "doc": "Le montant total de la commande"
    },
    {
      "name": "timestamp",
      "type": "long",
      "logicalType": "timestamp-millis",
      "doc": "Date de création (epoch millis)"
    }
  ]
}